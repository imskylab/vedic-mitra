<!-- Support — a coin dropping into a carved donation box (daana-patra). Duotone brand glyph
     (maroon + gold), drawn so the silhouette still reads once the navigation bar tints it flat. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="48"
    android:viewportHeight="48">
    <group android:pivotX="24" android:pivotY="24" android:scaleX="1.05" android:scaleY="1.05">
    <!-- The coin, mid-drop above the slot. -->
    <path
        android:fillColor="#FFC6971F"
        android:pathData="M17,11 a7,7 0 1,0 14,0 a7,7 0 1,0 -14,0 Z" />
    <!-- A stamped inner ring, echoing the milled edge of the reference artwork. -->
    <path
        android:pathData="M19.6,11 a4.4,4.4 0 1,0 8.8,0 a4.4,4.4 0 1,0 -8.8,0 Z"
        android:strokeColor="#FF7C1D1D"
        android:strokeWidth="1.2" />
    <!-- Box body. -->
    <path
        android:fillColor="#FF7C1D1D"
        android:pathData="M11,26 H37 a2.5,2.5 0 0,1 2.5,2.5 V40.5 a2.5,2.5 0 0,1 -2.5,2.5 H11 a2.5,2.5 0 0,1 -2.5,-2.5 V28.5 a2.5,2.5 0 0,1 2.5,-2.5 Z" />
    <!-- The carved front panel, standing in for the ornate border. -->
    <path
        android:pathData="M14,30 H34 a1,1 0 0,1 1,1 V38 a1,1 0 0,1 -1,1 H14 a1,1 0 0,1 -1,-1 V31 a1,1 0 0,1 1,-1 Z"
        android:strokeColor="#FFC6971F"
        android:strokeWidth="1.1" />
    <!-- Lid, with the coin slot cut through it. -->
    <path
        android:fillColor="#FFC6971F"
        android:pathData="M8.5,20.5 H39.5 a2,2 0 0,1 2,2 V24 a2,2 0 0,1 -2,2 H8.5 a2,2 0 0,1 -2,-2 V22.5 a2,2 0 0,1 2,-2 Z" />
    <path
        android:fillColor="#FF7C1D1D"
        android:pathData="M19,22.3 H29 a1,1 0 0,1 1,1 V23.5 a1,1 0 0,1 -1,1 H19 a1,1 0 0,1 -1,-1 V23.3 a1,1 0 0,1 1,-1 Z" />
    </group>
</vector>
